# =========================================================================
#  CONTOH KONFIGURASI ENVIRONMENT — backend BPMP Lampung
#  -----------------------------------------------------------------------
#  Salin berkas ini menjadi `.env` lalu isi nilainya. Berkas ini SENGAJA
#  tidak memuat satu pun nilai sungguhan supaya aman ikut ter-commit.
#
#  Penanda:
#    [WAJIB]      dibutuhkan pada mode development maupun production
#    [PRODUCTION] wajib diisi saat NODE_ENV=production; di development boleh kosong
#    [OPSIONAL]   boleh dikosongkan
#
#  Kelengkapan diperiksa saat aplikasi dinyalakan oleh `config/env.js`.
#  Di production, variabel yang kurang akan MENGHENTIKAN proses saat boot —
#  ini disengaja, agar tidak berjalan dengan konfigurasi yang bolong.
# =========================================================================

# ---------- Mode & peladen ----------
# [WAJIB] "development" di lokal, "production" di Hostinger.
# Menentukan penyajian frontend, ketatnya CORS, dan perlakuan validasi.
NODE_ENV=development

# [OPSIONAL] Di Hostinger porta ditetapkan otomatis; biarkan kosong di sana.
PORT=5000

# [OPSIONAL] Zona waktu proses. Isi Asia/Jakarta agar tanggal statistik
# pengunjung tetap mengikuti WIB walau peladen berjalan pada UTC.
TZ=Asia/Jakarta

# ---------- Basis data (MySQL) ----------
# [WAJIB] Pada shared hosting Hostinger lazimnya "localhost".
DB_HOST=
# [OPSIONAL] Bawaan 3306.
DB_PORT=3306
# [WAJIB]
DB_USER=
# [OPSIONAL] Boleh kosong untuk MySQL lokal tanpa kata sandi.
# Di production HARUS diisi.
DB_PASSWORD=
# [WAJIB]
DB_NAME=

# ---------- Keamanan ----------
# [WAJIB] Kunci penandatangan JWT. Minimal 32 karakter di production.
# Pakai nilai acak yang kuat dan BERBEDA antara lokal dan production.
# Jangan pernah memakai "fallback_secret_key" — nilai itu sudah tersebar
# di riwayat repositori dan akan ditolak saat production.
JWT_SECRET=

# [PRODUCTION] Alamat publik situs, lengkap dengan skema. Contoh bentuk:
# https://domain-anda.id
PUBLIC_BASE_URL=

# [PRODUCTION] Origin yang boleh memanggil API. Pisahkan dengan koma bila
# lebih dari satu. Di development lazimnya porta dev server Vite.
CORS_ORIGIN=

# [OPSIONAL] Letak folder hasil build frontend. Kosongkan bila `backend/` dan
# `frontend/` bersebelahan (penataan baku). Isi hanya bila penataan folder di
# peladen memaksa bentuk lain, contoh: /home/user/domains/situs/public_html/dist
FRONTEND_DIST_PATH=

# ---------- Pengiriman surel (Resend) ----------
# [PRODUCTION] Kunci API dari dashboard Resend. Dipakai fitur Lupa Password.
RESEND_API_KEY=

# [PRODUCTION] Alamat pengirim. HARUS memakai domain yang sudah diverifikasi
# di Resend. Domain uji bawaan Resend hanya bisa mengirim ke alamat pemilik
# akun, sehingga admin lain tidak akan menerima OTP.
RESEND_FROM_EMAIL=

# ---------- Layanan pihak ketiga ----------
# [OPSIONAL] YouTube Data API v3. Bila kosong, bagian video memakai tembolok.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# [OPSIONAL] RapidAPI untuk profil Instagram.
RAPIDAPI_KEY=

# ---------- Penjadwal (cron) ----------
# [PRODUCTION] Rahasia bersama bagi Cron Job hPanel yang memanggil
# POST /api/cron/instagram. Dikirim lewat tajuk `X-Cron-Secret`.
#
# Bila dikosongkan, titik akhir cron MENOLAK seluruh permintaan (503) —
# disengaja, agar konfigurasi yang kurang tidak berubah menjadi titik akhir
# terbuka yang bisa dipicu siapa pun. Akibatnya tembolok Instagram tidak akan
# pernah disegarkan otomatis, tetapi situs tetap berjalan normal.
#
# Pakai nilai acak yang kuat, misalnya keluaran:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------- Penjaga seeder ----------
# [OPSIONAL] Seeder menolak jalan saat NODE_ENV=production kecuali variabel
# ini bernilai true. Nyalakan hanya saat sengaja menyiapkan akun admin awal,
# lalu segera kembalikan ke kosong.
ALLOW_PRODUCTION_SEED=

# [OPSIONAL] Kata sandi akun superadmin yang dibuat seeder. Bila kosong,
# seeder memakai nilai cadangan yang HANYA berlaku di development.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD_2=

# ---------- Catatan ----------
# YOUTUBE_USER_ID pernah tercantum di .env tetapi tidak dibaca oleh satu
# berkas pun. Sengaja tidak disertakan di sini. Hapus dari .env Anda bila
# memang sisa masa lalu.
