# =========================================================================
#  CONTOH KONFIGURASI ENVIRONMENT — backend BPMP Lampung
#  -----------------------------------------------------------------------
#  Salin berkas ini menjadi `.env` lalu isi nilainya. Berkas ini SENGAJA
#  tidak memuat satu pun nilai sungguhan supaya aman ikut ter-commit.
#
#  Penanda:
#    [WAJIB]      dibutuhkan pada mode development maupun production
#    [PRODUCTION] wajib diisi saat NODE_ENV=production; di development boleh kosong
#    [OPSIONAL]   boleh dikosongkan
#
#  Kelengkapan diperiksa saat aplikasi dinyalakan oleh `config/env.js`.
#  Di production, variabel yang kurang akan MENGHENTIKAN proses saat boot —
#  ini disengaja, agar tidak berjalan dengan konfigurasi yang bolong.
#
#  URUTAN KEMENANGAN NILAI
#  -----------------------
#  Pengelola environment (panel hosting) MENANG atas berkas `.env`. Berkas
#  `.env` hanya mengisi variabel yang belum ditetapkan platform. Ini perilaku
#  bawaan dotenv, dan sengaja dipakai supaya panel benar-benar berkuasa penuh.
#
#  RIWAYAT — jangan dibalik lagi tanpa sebab:
#    27 Juli 2026  panel hPanel menolak menyimpan perubahan, sehingga pemuat
#                  dibuat MENIMPA sebagai jalan keluar darurat.
#    28 Juli 2026  panel pulih, `.env` dicabut dari paket — tetapi setelan
#                  menimpanya tertinggal.
#    29 Juli 2026  akibatnya muncul: RESEND_API_KEY diperbarui di panel
#                  berulang kali tetapi aplikasi tetap memakai kunci lama
#                  (Resend membalas 401). Setelan dikembalikan ke bawaan.
#
#  DI PELADEN, JANGAN LETAKKAN BERKAS .env. Biarkan seluruh nilai berasal dari
#  panel supaya hanya ada satu sumber kebenaran. Perlu diingat: mengekstrak ZIP
#  TIDAK menghapus berkas yang tidak ada di dalam arsip, sehingga `.env` sisa
#  penempatan lama bisa bertahan tanpa disadari. Log saat boot menyebutkan bila
#  berkasnya ditemukan — periksa baris `[env]` bila ada nilai yang terasa aneh.
#
#  Bila kelak panel bermasalah lagi, setel ENV_FILE_OVERRIDE=true (boleh di
#  dalam .env itu sendiri) agar berkas kembali menimpa panel. Pemakaiannya
#  dicatat sebagai peringatan menyolok di log. `NODE_ENV` dan `PORT` tetap tidak
#  dapat ditimpa dalam keadaan apa pun sebab ditetapkan platform.
#  Lihat `config/muatEnv.js`.
#
#  DUA JEBAKAN KHAS PENGELOLA ENVIRONMENT
#  --------------------------------------
#  1. MENYIMPAN DI PANEL TIDAK MENJALANKAN ULANG PROSES. Node membaca seluruh
#     variabel sekali saja, saat proses hidup. Menyegarkan peramban tidak ada
#     hubungannya. Sesudah menyimpan, tekan Restart pada aplikasinya — tanpa itu
#     nilai lama tetap dipakai dan panel terlihat seolah tidak berpengaruh.
#
#  2. PANEL TIDAK MENGURAI TANDA KUTIP. Menulis KUNCI="abc" di berkas .env
#     menghasilkan abc, sebab dotenv menguraikannya. Menempelkan "abc" ke kolom
#     panel menghasilkan nilai yang benar-benar memuat tanda kutip, sehingga
#     kunci yang sah pun ditolak. Sejak 29 Juli 2026 tanda kutip pengapit dibuang
#     otomatis untuk variabel yang formatnya tidak mungkin memuatnya, dan
#     kejadiannya dicatat sebagai peringatan — tetapi hapus juga di panel.
#
#  CARA MEMASTIKAN (dua perintah, dapat dijalankan dari panel):
#    npm run cek:env     — memperlihatkan ASAL setiap nilai: `panel`, `.env`,
#                          atau `-`. Bila yang Anda ubah di panel tetap berasal
#                          dari `.env`, berarti namanya tidak cocok atau belum
#                          dipasang di panel. Sertakan pula sidik jari nilai
#                          rahasia; sidik yang tidak berubah sesudah Restart
#                          membuktikan nilainya memang belum berganti.
#    npm run cek:resend  — menguji kunci Resend yang SEDANG DIPEGANG proses
#                          langsung ke Resend, lalu memisahkan mana yang salah:
#                          asal nilainya, bentuk nilainya, atau kuncinya sendiri.
# =========================================================================

# ---------- Mode & peladen ----------
# [WAJIB] "development" di lokal, "production" di Hostinger.
# Menentukan penyajian frontend, ketatnya CORS, dan perlakuan validasi.
NODE_ENV=development

# [OPSIONAL] Di Hostinger porta ditetapkan otomatis; biarkan kosong di sana.
PORT=5000

# [OPSIONAL] Zona waktu proses. Isi Asia/Jakarta agar tanggal statistik
# pengunjung tetap mengikuti WIB walau peladen berjalan pada UTC.
TZ=Asia/Jakarta

# ---------- Basis data (MySQL) ----------
# [WAJIB] Pada shared hosting Hostinger lazimnya "localhost".
DB_HOST=
# [OPSIONAL] Bawaan 3306.
DB_PORT=3306
# [WAJIB]
DB_USER=
# [OPSIONAL] Boleh kosong untuk MySQL lokal tanpa kata sandi.
# Di production HARUS diisi.
DB_PASSWORD=
# [WAJIB]
DB_NAME=

# [OPSIONAL] Jalur soket Unix MySQL.
#
# Perlu dipahami sebabnya. MySQL mengenali pengguna sebagai PASANGAN (nama,
# host), sehingga 'pengguna'@'localhost' dan 'pengguna'@'127.0.0.1' adalah dua
# akun berbeda. Peladen bersama lazimnya hanya membuat akun @'localhost'.
#
# Berbeda dari PHP, pustaka mysql2 pada Node SELALU menyambung lewat TCP —
# 'localhost' pun diresolusi menjadi 127.0.0.1. Akibatnya MySQL menolak dengan
# bunyi "Access denied for user 'x'@'127.0.0.1'" walaupun nama pengguna dan
# sandinya benar, dan phpMyAdmin di peladen yang sama tetap bisa masuk.
#
# Kosongkan saja: knexfile mencari sendiri pada jalur yang lazim
# (/var/lib/mysql/mysql.sock dan lainnya) bila DB_HOST menunjuk localhost.
# Isi manual bila peladen Anda memakai jalur tak lazim, atau isi "none" untuk
# memaksa TCP.
DB_SOCKET_PATH=

# ---------- Keamanan ----------
# [WAJIB] Kunci penandatangan JWT. Minimal 32 karakter di production.
# Pakai nilai acak yang kuat dan BERBEDA antara lokal dan production.
# Jangan pernah memakai "fallback_secret_key" — nilai itu sudah tersebar
# di riwayat repositori dan akan ditolak saat production.
JWT_SECRET=

# [OPSIONAL] Alamat publik situs, lengkap dengan skema. Contoh bentuk:
# https://domain-anda.id
#
# Variabel ini pernah berstatus [PRODUCTION], dan itu keliru: sejak Tahap 4
# mengubah URL aset menjadi relatif, TIDAK ADA satu berkas kode pun yang
# membacanya. Statusnya luput diturunkan, dan akibatnya penempatan 27 Juli 2026
# terhalang berjam-jam demi variabel yang tidak berpengaruh apa-apa.
#
# Kaidah yang dipetik: sebuah variabel hanya boleh berstatus wajib bila ada kode
# yang benar-benar membacanya. Bila kelak dipakai kembali, naikkan lagi statusnya
# di sini BERSAMAAN dengan config/env.js dan scripts/cek-env.js — ketiganya harus
# selalu sepakat.
PUBLIC_BASE_URL=

# [PRODUCTION] Origin yang boleh memanggil API. Pisahkan dengan koma bila
# lebih dari satu. Di development lazimnya porta dev server Vite.
CORS_ORIGIN=

# [OPSIONAL] Letak folder hasil build frontend. Kosongkan bila `backend/` dan
# `frontend/` bersebelahan (penataan baku). Isi hanya bila penataan folder di
# peladen memaksa bentuk lain, contoh: /home/user/domains/situs/public_html/dist
FRONTEND_DIST_PATH=

# [OPSIONAL, TETAPI WAJIB DI HOSTINGER] Letak folder penyimpanan berkas unggahan
# (gambar editor, logo mitra, avatar Instagram). Kosongkan di lokal — nilai
# bawaannya `backend/uploads` sehingga perilaku pengembangan tidak berubah.
#
# MENGAPA PENTING DI PELADEN: penempatan ulang menyapu isi folder aplikasi,
# sehingga berkas unggahan yang tersimpan DI DALAM folder aplikasi ikut lenyap
# setiap kali paket baru diekstrak — seluruh gambar pada situs menjadi rusak.
# Diisi dengan folder DI LUAR folder aplikasi agar selamat melewati penempatan.
# Contoh di Hostinger: /home/u520976196/upload-img
#
# Bila variabel ini kosong di production, aplikasi tetap menyala tetapi menulis
# dan menyajikan gambar dari dalam folder aplikasi — dan gambarnya akan hilang
# lagi pada penempatan berikutnya.
UPLOAD_DIR=

# ---------- Pengiriman surel (Resend) ----------
# [PRODUCTION] Kunci API dari dashboard Resend. Dipakai fitur Lupa Password.
#
# Tempel NILAINYA SAJA — tanpa tanda kutip, tanpa spasi di ujung. Sesudah
# menyimpannya di panel, tekan Restart, lalu buktikan dengan `npm run cek:resend`
# alih-alih menebak dari pesan galat. Perlu diketahui: Resend membalas 401 bila
# kunci tidak dikenali, tetapi 400 bila bentuk kuncinya cacat (mis. tersalin
# sebagian) — keduanya sama-sama berbunyi "API key is invalid".
RESEND_API_KEY=

# [PRODUCTION] Alamat pengirim. HARUS memakai domain yang sudah diverifikasi
# di Resend. Domain uji bawaan Resend hanya bisa mengirim ke alamat pemilik
# akun, sehingga admin lain tidak akan menerima OTP.
RESEND_FROM_EMAIL=

# ---------- Layanan pihak ketiga ----------
# [OPSIONAL] YouTube Data API v3. Bila kosong, bagian video memakai tembolok.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# [OPSIONAL] RapidAPI untuk profil Instagram.
RAPIDAPI_KEY=

# ---------- Penjadwal (cron) ----------
# [PRODUCTION] Rahasia bersama bagi Cron Job hPanel yang memanggil
# POST /api/cron/instagram. Dikirim lewat tajuk `X-Cron-Secret`.
#
# Bila dikosongkan, titik akhir cron MENOLAK seluruh permintaan (503) —
# disengaja, agar konfigurasi yang kurang tidak berubah menjadi titik akhir
# terbuka yang bisa dipicu siapa pun. Akibatnya tembolok Instagram tidak akan
# pernah disegarkan otomatis, tetapi situs tetap berjalan normal.
#
# Pakai nilai acak yang kuat, misalnya keluaran:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------- Alat diagnosis ----------
# [OPSIONAL] Isi "true" untuk memerintahkan peladen memeriksa sambungan basis
# data sekali saat boot dan mencetak hasilnya ke log. Berguna pada paket hosting
# yang tidak menyediakan akses terminal, sebab log menjadi satu-satunya saluran
# keluaran. Pemeriksaannya mencoba beberapa alamat sekaligus — host dari
# DB_HOST, localhost, 127.0.0.1, dan beberapa jalur soket — lalu melaporkan mana
# yang berhasil.
#
# Kegagalannya TIDAK menjatuhkan peladen. Kembalikan ke kosong setelah selesai:
# keluarannya memuat nama pengguna dan nama basis data.
DIAGNOSA_DB=

# ---------- Penjaga seeder ----------
# [OPSIONAL] Seeder menolak jalan saat NODE_ENV=production kecuali variabel
# ini bernilai true. Nyalakan hanya saat sengaja menyiapkan akun admin awal,
# lalu segera kembalikan ke kosong.
ALLOW_PRODUCTION_SEED=

# [OPSIONAL] Kata sandi akun superadmin yang dibuat seeder. Bila kosong,
# seeder memakai nilai cadangan yang HANYA berlaku di development.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD_2=

# ---------- Catatan ----------
# YOUTUBE_USER_ID pernah tercantum di .env tetapi tidak dibaca oleh satu
# berkas pun. Sengaja tidak disertakan di sini. Hapus dari .env Anda bila
# memang sisa masa lalu.
